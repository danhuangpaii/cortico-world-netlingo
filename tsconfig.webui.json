{
  // 面板在浏览器里跑,需要 DOM 类型;与 Node 侧的 tsconfig.json 分开。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/webui/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
