{
  "name": "cortico-world-netlingo",
  "version": "0.3.8",
  "type": "module",
  "description": "可以自主在互联网上找梗玩,也可以当成一个简便的小浏览器;接入 QQ 群后会自主学习群友的梗并加进自己的梗库使用。建议搭配各大佬的 QQ 扩展。",
  "license": "MIT",
  "author": "danhuangpai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danhuangpaii/cortico-world-netlingo.git"
  },
  "homepage": "https://github.com/danhuangpaii/cortico-world-netlingo#readme",
  "bugs": {
    "url": "https://github.com/danhuangpaii/cortico-world-netlingo/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "slang",
    "meme",
    "网络语言",
    "网络用语",
    "梗",
    "梗图",
    "群聊"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "网络语言",
    "tags": [
      "internet",
      "companion"
    ],
    "locales": {
      "zh": {
        "displayName": "网络语言",
        "description": "自主上网找梗玩,也能当简便小浏览器;接进 QQ 群会学群友的梗并加进梗库。"
      },
      "en": {
        "displayName": "Netlingo",
        "description": "Finds memes on its own across the web, doubles as a lightweight browser, and learns the memes of a QQ group it joins."
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json",
    "build:webui": "node scripts/build-webui.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
