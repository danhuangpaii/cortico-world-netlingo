{
  "name": "cortico-world-netlingo",
  "version": "0.3.2",
  "type": "module",
  "description": "让 Coo 可以自己总结、自己上网搜索并保存梗到本地的扩展,建议搭配各大佬的 QQ 接入扩展使用;也可以当作一个互联网接口使用,查网络用语、热榜与评论区。",
  "license": "MIT",
  "author": "danhuangpai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danhuangpaii/cortico-world-netlingo.git"
  },
  "homepage": "https://github.com/danhuangpaii/cortico-world-netlingo#readme",
  "bugs": {
    "url": "https://github.com/danhuangpaii/cortico-world-netlingo/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "slang",
    "meme",
    "网络语言",
    "网络用语",
    "梗",
    "梗图",
    "群聊"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "网络语言",
    "tags": [
      "internet",
      "companion"
    ],
    "locales": {
      "zh": {
        "displayName": "网络语言",
        "description": "让 Coo 自己上网查梗、记梗图、在群里接话。"
      },
      "en": {
        "displayName": "Netlingo",
        "description": "Lets the bot look up slang and memes, keep them, and join the chat."
      }
    },
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
